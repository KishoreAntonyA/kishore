{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["client", "admin"]
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["uid", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Client order tracking deliverable progress and financial statuses",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "orderNumber": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "clientEmail": {
          "type": "string"
        },
        "serviceId": {
          "type": "string"
        },
        "serviceTitle": {
          "type": "string"
        },
        "totalAmount": {
          "type": "number"
        },
        "paidAmount": {
          "type": "number"
        },
        "status": {
          "type": "string"
        },
        "statusLabel": {
          "type": "string"
        },
        "progressPercentage": {
          "type": "number"
        }
      },
      "required": ["id", "orderNumber", "clientName", "serviceId", "totalAmount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile records"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Production orders and deliverable tracking"
    }
  }
}
